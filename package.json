{
  "name": "four-four-two",
  "private": true,
  "version": "0.1.0",
  "description": "4-4-2 — a turn-based, card-driven 6-a-side football manager game (Three.js + TypeScript).",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch src/server/main.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "tsx src/server/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "simulate": "tsx scripts/simulate.ts"
  },
  "dependencies": {
    "three": "^0.170.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/three": "^0.170.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^3.0.0"
  }
}
